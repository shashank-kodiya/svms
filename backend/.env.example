# Copy this file to .env and fill in real values. Never commit .env to GitHub.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Database > Connect > Drivers)
# Replace <username>, <password> and the cluster address with your own.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/svms?retryWrites=true&w=majority

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Login/register attempts allowed per IP every 15 minutes
AUTH_RATE_LIMIT=20

# Frontend address allowed to call this API (comma-separate several)
CLIENT_URL=http://localhost:5173

# Cloudinary (Phase 2: vehicle photos). Dashboard > Settings > API Keys.
# Leave empty to skip photos; everything else still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by "npm run seed" to create the first admin account
ADMIN_EMAIL=admin@svms.local
ADMIN_PASSWORD=ChangeMe@123

# Phase 8: email through Brevo (https://www.brevo.com, free plan). Leave empty to skip email;
# notifications still appear inside the app. Use a sender address you verified in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Smart Vehicle Service

# Phase 8: set to "off" to stop the daily reminder job (npm run reminders still works)
# REMINDERS=off

# Phase 9: Google Maps. Both keys are optional. Without them the app still lists centers with a straight-line
# distance and a recommendation score, and road distance/time is an estimate.
# Server key (Google Cloud > Credentials): enable Geocoding API, Routes API and Places API (New).
# Restrict it to those APIs; never put it in the frontend.
GOOGLE_MAPS_SERVER_KEY=
