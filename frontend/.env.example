# Copy to .env. Only VITE_ variables reach the browser, so never put secrets here.
VITE_API_URL=http://localhost:5000/api

# Phase 9: browser key for the map itself (enable "Maps JavaScript API"). It is visible in the browser by design,
# so restrict it to your website addresses (HTTP referrers) in Google Cloud. Leave empty to hide the map.
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# Map ID for advanced map markers (Google Cloud > Maps Management). Leave empty to use Google's DEMO_MAP_ID while developing.
VITE_GOOGLE_MAP_ID=
